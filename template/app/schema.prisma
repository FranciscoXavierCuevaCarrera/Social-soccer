datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  email    String? @unique
  username String? @unique
  isAdmin  Boolean @default(false)

  paymentProcessorUserId        String?   @unique
  lemonSqueezyCustomerPortalUrl String?
  subscriptionStatus            String?
  subscriptionPlan              String?
  datePaid                      DateTime?
  credits                       Int       @default(3)

  gptResponses        GptResponse[]
  contactFormMessages ContactFormMessage[]
  tasks               Task[]
  files               File[]

  // SocialSoccer MVP Relations
  playerProfile  PlayerProfile?
  payments       Payment[]
  tickets        Ticket[]
  refereeRatings RefereeRating[]
  matchesCreated Match[]         @relation("CreatedMatches")
  matchPlayers   MatchPlayer[]
}

model GptResponse {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String

  content String
}

model Task {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  description String
  time        String  @default("1")
  isDone      Boolean @default(false)
}

model File {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  name  String
  type  String
  s3Key String
}

model DailyStats {
  id   Int      @id @default(autoincrement())
  date DateTime @unique @default(now())

  totalViews                Int    @default(0)
  prevDayViewsChangePercent String @default("0")
  userCount                 Int    @default(0)
  paidUserCount             Int    @default(0)
  userDelta                 Int    @default(0)
  paidUserDelta             Int    @default(0)
  totalRevenue              Float  @default(0)
  totalProfit               Float  @default(0)

  sources PageViewSource[]
}

model PageViewSource {
  name String
  date DateTime @default(now())

  dailyStats   DailyStats? @relation(fields: [dailyStatsId], references: [id])
  dailyStatsId Int?

  visitors Int

  @@id([date, name])
}

model Logs {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  message String
  level   String
}

model ContactFormMessage {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  content   String
  isRead    Boolean   @default(false)
  repliedAt DateTime?
}

// ==========================================
// SocialSoccer MVP Models & Entities
// ==========================================

model PlayerProfile {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  cedula      String?
  fullName    String
  photoUrl    String?
  currentClub String  @default("Libre")
  position    String  @default("Mediocampista")
  number      Int?
  qrCode      String  @unique @default(uuid())
  passStatus  String  @default("ACTIVE")

  stats   PlayerStats?
  tickets Ticket[]
}

model Field {
  id       String  @id @default(uuid())
  name     String
  location String
  surface  String? @default("Sintetico")

  matches Match[]
}

model Referee {
  id            String  @id @default(uuid())
  fullName      String
  badgeNumber   String?
  averageRating Float   @default(5.0)

  matches Match[]
  ratings RefereeRating[]
}

model Match {
  id           String        @id @default(uuid())
  createdAt    DateTime      @default(now())
  location     String        @default("Cancha Principal")
  dateTime     DateTime      @default(now())
  maxPlayers   Int           @default(10)
  createdById  String?
  createdBy    User?         @relation("CreatedMatches", fields: [createdById], references: [id])
  players      MatchPlayer[]

  date         DateTime?     @default(now())
  time         String?       @default("19:00")
  homeTeam     String?       @default("Local")
  awayTeam     String?       @default("Visitante")
  homeScore    Int?
  awayScore    Int?
  status       String        @default("SCHEDULED")
  weatherAlert String?

  field        Field?        @relation(fields: [fieldId], references: [id])
  fieldId      String?

  referee      Referee?      @relation(fields: [refereeId], references: [id])
  refereeId    String?

  payments       Payment[]
  tickets        Ticket[]
  playerStats    PlayerStats[]
  refereeRatings RefereeRating[]
}

model MatchPlayer {
  id        String   @id @default(uuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([matchId, userId])
}

model Payment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  match   Match?  @relation(fields: [matchId], references: [id])
  matchId String?

  amount        Float
  concept       String
  paymentMethod String  @default("DEUNA")
  status        String  @default("COMPLETED")
  receiptUrl    String?
}

model Ticket {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  match   Match  @relation(fields: [matchId], references: [id])
  matchId String

  playerProfile   PlayerProfile? @relation(fields: [playerProfileId], references: [id])
  playerProfileId String?

  qrToken String  @unique @default(uuid())
  seat    String?
  price   Float
  isUsed  Boolean @default(false)
}

model PlayerStats {
  id String @id @default(uuid())

  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String        @unique

  match   Match?  @relation(fields: [matchId], references: [id])
  matchId String?

  goals         Int @default(0)
  assists       Int @default(0)
  yellowCards   Int @default(0)
  redCards      Int @default(0)
  fairPlayScore Int @default(100)
  matchesPlayed Int @default(0)
}

model RefereeRating {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  referee   Referee @relation(fields: [refereeId], references: [id])
  refereeId String

  match   Match  @relation(fields: [matchId], references: [id])
  matchId String

  stars   Int     @default(5)
  comment String?
}